# .env file banao is naam se (bina .example ke) aur apni values daalo

# Google Gemini API key — https://aistudio.google.com/apikey se milegi
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (Config mein defaults already set hain)
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=intfloat/multilingual-e5-large